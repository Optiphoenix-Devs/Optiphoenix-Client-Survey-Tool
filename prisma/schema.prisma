generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Org Admin = sees every team
// Team Lead = sees only teams they belong to (created or invited)
enum UserRole {
  ADMIN
  TEAM_LEAD
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// Form builder: still editing vs live template
enum FormBuilderStatus {
  DRAFT
  PUBLISHED
}

// One form sent to one client
enum SurveyStatus {
  UPCOMING
  OPENED
  IN_PROGRESS
  CLOSED
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  DROPDOWN
  COMMENT
  SUGGESTION
  RATING
  RESOURCE_RATING
  YES_NO
}

model User {
  id                   String        @id @default(cuid())
  email                String        @unique
  password             String
  name                 String
  role                 UserRole      @default(TEAM_LEAD)
  status               AccountStatus @default(APPROVED)
  avatarUrl            String?
  failedLoginAttempts  Int           @default(0)
  lockedUntil          DateTime?
  resetRequestedAt     DateTime?
  signupTokenHash      String?
  signupTokenExpiresAt DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  createdTeams         Team[]              @relation("TeamCreator")
  memberships          TeamMembership[]
  sentInvites          TeamInvite[]        @relation("InviteSender")
  createdForms         Form[]              @relation("FormCreator")
  createdClients       Client[]            @relation("ClientCreator")
  createdTemplates     FormTemplate[]      @relation("TemplateCreator")
  passwordResetTokens  PasswordResetToken[]

  @@index([signupTokenHash])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdBy   User     @relation("TeamCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  TeamMembership[]
  invites  TeamInvite[]
  clients  Client[]
  forms    Form[]
}

// Accepted membership: this user can see this team's data
model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

// Admin or Team Lead invites someone into a team
model TeamInvite {
  id          String       @id @default(cuid())
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email       String
  invitedById String
  invitedBy   User         @relation("InviteSender", fields: [invitedById], references: [id])
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([teamId, email])
  @@index([email])
}

model Client {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("ClientCreator", fields: [createdById], references: [id])
  name        String
  email       String?
  company     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  surveys   ClientSurvey[]
  forms     Form[]
  resources Resource[]

  @@index([teamId])
}

// People the client can rate on this account (not the same as login users)
model Resource {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Form {
  id               String            @id @default(cuid())
  teamId           String?
  team             Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  clientId         String?
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User              @relation("FormCreator", fields: [createdById], references: [id])
  sourceTemplateId String?
  sourceTemplate   FormTemplate?     @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  title            String
  description      String?           @db.Text
  status           FormBuilderStatus @default(DRAFT)
  publicToken      String            @unique @default(cuid())
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  questions Question[]
  surveys   ClientSurvey[]

  @@index([teamId])
  @@index([clientId])
  @@index([createdById])
  @@index([sourceTemplateId])
}

model FormTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  createdById String
  createdBy   User     @relation("TemplateCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions FormTemplateQuestion[]
  forms     Form[]

  @@index([createdById])
}

model FormTemplateQuestion {
  id          String       @id @default(cuid())
  templateId  String
  template    FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  type        QuestionType
  label       String
  description String?      @db.Text
  order       Int
  required    Boolean      @default(false)
  options     Json?

  @@index([templateId, order])
}

// One public fill session for a client-owned form. Unpublish does not delete this.
model ClientSurvey {
  id           String       @id @default(cuid())
  formId       String
  form         Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  publicToken  String       @unique @default(cuid())
  status       SurveyStatus @default(UPCOMING)
  openedAt     DateTime?
  submittedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  responses Response[]

  @@index([clientId, status])
  @@index([formId])
}

model Question {
  id          String       @id @default(cuid())
  formId      String
  form        Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  type        QuestionType
  label       String
  description String?      @db.Text
  order       Int
  required    Boolean      @default(false)
  options     Json?
  answers     Answer[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([formId, order])
}

model Response {
  id             String       @id @default(cuid())
  clientSurveyId String
  clientSurvey   ClientSurvey @relation(fields: [clientSurveyId], references: [id], onDelete: Cascade)
  answers        Answer[]
  submittedAt    DateTime     @default(now())

  @@index([clientSurveyId])
}

model Answer {
  id         String   @id @default(cuid())
  responseId String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  value      String   @db.Text

  @@unique([responseId, questionId])
}
