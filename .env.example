# Copy this file to .env and update values.
# Command: cp .env.example .env
# Never commit .env (it has passwords).

# Local MySQL (MAMP / Homebrew) — no SSL
# DATABASE_URL="mysql://root:root@localhost:8889/optiphoenix_survey"

# Aiven (cloud) — paste the URI from the Aiven console.
# Keep ssl-mode=REQUIRED. The service must show Running (free tier can power off).
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED"
