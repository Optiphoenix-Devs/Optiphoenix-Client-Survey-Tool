# Copy this file to .env and update values.
# Command: cp .env.example .env
# Never commit .env (it has passwords).

# MAMP (free app) — default user/password root/root, MySQL port 8889
DATABASE_URL="mysql://root:root@127.0.0.1:8889/optiphoenix_survey"

# Auth.js / NextAuth — generate a long random string for AUTH_SECRET
AUTH_SECRET="replace-with-a-long-random-string"
# Local:
AUTH_URL="http://localhost:3000"
# Production (Vercel) — set this in Vercel env vars (not in git):
# AUTH_URL="https://opti-survery.vercel.app"

# Gemini (free tier) — used first for /dashboard/summarize
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional. Default is gemini-3.6-flash.
# GEMINI_MODEL="gemini-3.6-flash"

# Email (Resend - no SMTP needed)
# Create an account at https://resend.com and set API key.
RESEND_API_KEY=""
# "From" header used for all outgoing emails.
# Testing: OptiPhoenix <onboarding@resend.dev>
# Custom domain (after verifying domain in Resend): OptiPhoenix <noreply@yourdomain.com>
EMAIL_FROM="OptiPhoenix <onboarding@resend.dev>"

# OpenAI — optional fallback if GEMINI_API_KEY is empty
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Aiven (cloud) — only if you switch back
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED"
